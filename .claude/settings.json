{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m quizforge bank*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "quiz-forge": {
      "source": {
        "source": "directory",
        "path": "./plugin"
      }
    }
  },
  "enabledPlugins": {
    "quiz-forge-tools@quiz-forge": true,
    "qf-format@quiz-forge": true
  }
}
